

/* ================== GLOBAL ================== */
QWidget {
    background-color: #f0f2f5;
    color: #1f2937;
    font-family: "Segoe UI";
    font-size: 10pt;
}

/* ================== SIDEBAR ================== */
#sidebar {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 12px;
}

/* ================== CONTENT ================== */
#content, #topbar {
    background: transparent;
}

/* ================== GROUPBOX ================== */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    margin-top: 14px;
    padding: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    color: #374151;
    font-weight: 600;
}

/* ================== INPUTS ================== */
QLineEdit, QComboBox {
    min-height: 22px;
    padding: 4px 10px;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 8px;
    color: #1f2937;
}

QLineEdit:focus, QComboBox:focus {
    border: 1px solid #3a86ff;
}

/* Combo popup */
QComboBox QAbstractItemView {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    selection-background-color: #3a86ff;
    color: #1f2937;
}

/* ================== BUTTONS ================== */
QPushButton {
    min-height: 24px;
    padding: 4px 14px;
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 10px;
    color: #1f2937;
}

QPushButton:hover {
    background-color: #f3f4f6;
}

QPushButton:pressed {
    background-color: #e5e7eb;
}

QPushButton#ApplySort {
    min-height: 34px;
    background-color: #3a86ff;
    border-color: #3a86ff;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#ApplySort:hover {
    background-color: #2f6ad0;
}

QPushButton#btnStopLive, QPushButton#LiveMode {
    background-color: #ef4444;
    border-color: #ef4444;
    color: #ffffff;
    font-weight: 700;
}

/* ================== TABLE ================== */
QTableWidget, QTableView {
    background-color: #ffffff;
    border: 1px solid #d1d5db;
    border-radius: 12px;
    gridline-color: #eef2f7;
    outline: 0;
    color: #1f2937;
}


QTableWidget::item, QTableView::item {
    padding: 6px 8px;
}
QTableWidget::item:selected, QTableView::item:selected {
    background-color: #dbeafe;
    color: #1e3a8a;
}

QHeaderView {
    background-color: #f3f4f6;
    border: none;
}

QHeaderView::section {
    background-color: #f3f4f6;
    color: #374151;
    padding: 8px 10px;
    font-weight: 600;
    border: none;
    border-right: 1px solid #ffffff;
}

QHeaderView::section:last {
    border-right: none;
}

QTableCornerButton::section {
    background-color: #f3f4f6;
    border: none;
}

/* ================== SCROLLBAR ================== */
QScrollBar:vertical {
    background: transparent;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #cbd5e1;
    border-radius: 5px;
    min-height: 30px;
}

QScrollBar::add-line, QScrollBar::sub-line {
    height: 0;
}
